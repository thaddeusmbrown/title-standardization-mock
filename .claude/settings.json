{
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push -*)",
      "Bash(git push * -*)",
      "Bash(git push origin)",
      "Bash(git push origin *)",
      "Bash(git push claude)",
      "Bash(git push .*)",
      "Bash(git push /*)",
      "Bash(git push ~*)",
      "Bash(git push *://*)",
      "Bash(git push *@*)",
      "Bash(git push * +*)",
      "Bash(git push * :*)",
      "Bash(git push * HEAD*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * main:*)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *heads/main*)",
      "Bash(git push * refs/*)",
      "Bash(git push *:refs/tags/*)",
      "Bash(git push * tag *)",
      "Bash(gh)",
      "Bash(gh -*)",
      "Bash(gh * -R *)",
      "Bash(gh *--repo*)",
      "Bash(gh *--hostname*)",
      "Bash(gh *--web*)",
      "Bash(gh agent-task*)",
      "Bash(gh alias*)",
      "Bash(gh attestation*)",
      "Bash(gh auth*)",
      "Bash(gh browse*)",
      "Bash(gh cache*)",
      "Bash(gh co*)",
      "Bash(gh cs*)",
      "Bash(gh ext*)",
      "Bash(gh gist*)",
      "Bash(gh gpg-key*)",
      "Bash(gh issue*)",
      "Bash(gh label*)",
      "Bash(gh org*)",
      "Bash(gh preview*)",
      "Bash(gh project*)",
      "Bash(gh release*)",
      "Bash(gh ruleset*)",
      "Bash(gh search*)",
      "Bash(gh secret*)",
      "Bash(gh ssh-key*)",
      "Bash(gh status*)",
      "Bash(gh variable*)",
      "Bash(gh workflow*)",
      "Bash(gh pr)",
      "Bash(gh pr -*)",
      "Bash(gh pr checkout*)",
      "Bash(gh pr close*)",
      "Bash(gh pr comment*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr edit*)",
      "Bash(gh pr list*)",
      "Bash(gh pr lock*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr new*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr reopen*)",
      "Bash(gh pr revert*)",
      "Bash(gh pr review*)",
      "Bash(gh pr status*)",
      "Bash(gh pr unlock*)",
      "Bash(gh pr update-branch*)",
      "Bash(gh pr create *--fill*)",
      "Bash(gh pr create *--body *)",
      "Bash(gh pr create * -b *)",
      "Bash(gh pr create *--base build/*)",
      "Bash(gh pr view *body*)",
      "Bash(gh pr view *comments*)",
      "Bash(gh pr view * -c*)",
      "Bash(gh pr view *reviews*)",
      "Bash(gh pr view *Reviews*)",
      "Bash(gh run cancel*)",
      "Bash(gh run delete*)",
      "Bash(gh run download*)",
      "Bash(gh run rerun*)",
      "Bash(gh run watch*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo autolink*)",
      "Bash(gh repo clone*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo gitignore*)",
      "Bash(gh repo license*)",
      "Bash(gh repo list*)",
      "Bash(gh repo new*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh api*graphql*)",
      "Bash(gh api*-X*)",
      "Bash(gh api*--method*)",
      "Bash(gh api*-f*)",
      "Bash(gh api*-F*)",
      "Bash(gh api*--input*)",
      "Bash(gh api*-H*)",
      "Bash(gh api*--header*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/no-push.py\"; [ -r \"$f\" ] || exit 0; exec python3 -I \"$f\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff-format.sh\"; [ -r \"$f\" ] || exit 0; exec bash \"$f\"",
            "timeout": 30,
            "statusMessage": "Formatting with ruff"
          }
        ]
      }
    ]
  }
}
